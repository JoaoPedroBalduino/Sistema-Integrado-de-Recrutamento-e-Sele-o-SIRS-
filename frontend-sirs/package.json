  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
